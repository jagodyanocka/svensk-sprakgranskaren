POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=swedish_tutor
DATABASE_URL=postgresql+psycopg://swedish_tutor:changeme@localhost:5433/swedish_tutor

# Laptop (docker compose up):
LLM_URL=http://localhost:11434/v1
LLM_MODEL=changeme
LLM_API_KEY=ollama
HOST=0.0.0.0
PORT=8000
RELOAD=true

