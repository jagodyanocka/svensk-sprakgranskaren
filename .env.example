POSTGRES_USER=swedish_tutor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=swedish_tutor
DATABASE_URL=postgresql+psycopg://swedish_tutor:changeme@localhost:5433/swedish_tutor

# Laptop (docker compose up) — Ollama:
LLM_PROVIDER=ollama
LLM_URL=http://localhost:11434/v1
LLM_MODEL=gpt-oss:20b-cloud
LLM_API_KEY=ollama
HOST=0.0.0.0
PORT=8000
RELOAD=true

